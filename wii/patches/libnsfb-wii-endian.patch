+static SDL_Joystick *wii_pointer_joystick;
+static u32 wii_previous_buttons;
+static u32 wii_last_poll_ticks;
+static u32 wii_polled_buttons;
+static bool wii_polled_valid;
+static int wii_pointer_dx, wii_pointer_dy;
