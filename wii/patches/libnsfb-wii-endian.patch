+static u32 wii_canonical_buttons(u32 pressed)
+{
+    if (pressed & (WPAD_CLASSIC_BUTTON_ZR | WPAD_CLASSIC_BUTTON_PLUS))
+        pressed |= WPAD_BUTTON_PLUS;
+    if (pressed & (WPAD_CLASSIC_BUTTON_ZL | WPAD_CLASSIC_BUTTON_MINUS))
+        pressed |= WPAD_BUTTON_MINUS;
+    if (pressed & WPAD_CLASSIC_BUTTON_A)
+        pressed |= WPAD_BUTTON_A;
+    if (pressed & WPAD_CLASSIC_BUTTON_B)
+        pressed |= WPAD_BUTTON_B;
+    if (pressed & WPAD_CLASSIC_BUTTON_X)
+        pressed |= WPAD_BUTTON_2;
+    if (pressed & WPAD_CLASSIC_BUTTON_Y)
+        pressed |= WPAD_BUTTON_1;
+    if (pressed & WPAD_CLASSIC_BUTTON_HOME)
+        pressed |= WPAD_BUTTON_HOME;
+    if (pressed & WPAD_CLASSIC_BUTTON_UP)
+        pressed |= WPAD_BUTTON_UP;
+    if (pressed & WPAD_CLASSIC_BUTTON_DOWN)
+        pressed |= WPAD_BUTTON_DOWN;
+    if (pressed & WPAD_CLASSIC_BUTTON_LEFT)
+        pressed |= WPAD_BUTTON_LEFT;
+    if (pressed & WPAD_CLASSIC_BUTTON_RIGHT)
+        pressed |= WPAD_BUTTON_RIGHT;
+    return pressed;
+}
+
+static u32 wii_controller_buttons(void)
+{
+    u32 pressed = 0;
+    u32 gcpressed = 0;
+    unsigned int channel;
+
+    WUPC_UpdateButtonStats();
+    for (channel = 0; channel < 4; channel++)
+        pressed |= WUPC_ButtonsHeld(channel);
+    pressed = wii_canonical_buttons(pressed);
+
+    if (pressed != 0)
+        return pressed;
+
+    for (channel = 0; channel < 4; channel++)
+        pressed |= WPAD_ButtonsHeld(channel);
+    pressed = wii_canonical_buttons(pressed);
+
+    /* SDL already reports channel zero's A and B as mouse buttons. Suppress
+     * them here unless another channel is holding them, so that a single
+     * press is not reported twice. */
+    if ((pressed & (WPAD_BUTTON_A | WPAD_BUTTON_B)) != 0) {
+        u32 others = 0;
+
+        for (channel = 1; channel < 4; channel++)
+            others |= WPAD_ButtonsHeld(channel);
+        others = wii_canonical_buttons(others);
+
+        pressed &= ~(WPAD_BUTTON_A | WPAD_BUTTON_B);
+        pressed |= others & (WPAD_BUTTON_A | WPAD_BUTTON_B);
+    }
+
+    if (pressed != 0)
+        return pressed;
+
+    if (PAD_ScanPads() > PAD_ERR_NONE) {
+        for (channel = 0; channel < 4; channel++)
+            gcpressed |= PAD_ButtonsHeld(channel);
+        if (gcpressed & PAD_TRIGGER_R)
+            pressed |= WPAD_BUTTON_PLUS;
+        if (gcpressed & PAD_TRIGGER_L)
+            pressed |= WPAD_BUTTON_MINUS;
+        if (gcpressed & PAD_BUTTON_A)
+            pressed |= WPAD_BUTTON_A;
+        if (gcpressed & PAD_BUTTON_B)
+            pressed |= WPAD_BUTTON_B;
+        if (gcpressed & PAD_BUTTON_X)
+            pressed |= WPAD_BUTTON_2;
+        if (gcpressed & PAD_BUTTON_Y)
+            pressed |= WPAD_BUTTON_1;
+        if (gcpressed & PAD_BUTTON_MENU)
+            pressed |= WPAD_BUTTON_HOME;
+        if (gcpressed & PAD_BUTTON_UP)
+            pressed |= WPAD_BUTTON_UP;
+        if (gcpressed & PAD_BUTTON_DOWN)
+            pressed |= WPAD_BUTTON_DOWN;
+        if (gcpressed & PAD_BUTTON_LEFT)
+            pressed |= WPAD_BUTTON_LEFT;
+        if (gcpressed & PAD_BUTTON_RIGHT)
+            pressed |= WPAD_BUTTON_RIGHT;
+    }
+    return pressed;
+}
+
+static bool wii_controller_event(nsfb_event_t *event)
+{
+    static const u32 masks[] = {
+        WPAD_BUTTON_A, WPAD_BUTTON_B,
+        WPAD_BUTTON_UP, WPAD_BUTTON_DOWN,
+        WPAD_BUTTON_LEFT, WPAD_BUTTON_RIGHT,
+        WPAD_BUTTON_PLUS, WPAD_BUTTON_MINUS,
+        WPAD_BUTTON_1, WPAD_BUTTON_2, WPAD_BUTTON_HOME
+    };
+    static const enum nsfb_key_code_e keys[] = {
+        NSFB_KEY_MOUSE_1, NSFB_KEY_MOUSE_3,
+        NSFB_KEY_UP, NSFB_KEY_DOWN,
+        NSFB_KEY_LEFT, NSFB_KEY_RIGHT,
+        NSFB_KEY_PLUS, NSFB_KEY_MINUS,
+        NSFB_KEY_PAGEUP, NSFB_KEY_PAGEDOWN, NSFB_KEY_ESCAPE
+    };
+    u32 current;
+    u32 changed;
+    unsigned int index;
+
+    if (!wii_polled_valid)
+        return false;
+
+    current = wii_polled_buttons;
+    changed = current ^ wii_previous_buttons;
+
+    for (index = 0; index < sizeof(masks) / sizeof(masks[0]); index++) {
+        if ((changed & masks[index]) != 0) {
+            event->type = (current & masks[index]) != 0 ?
+                    NSFB_EVENT_KEY_DOWN : NSFB_EVENT_KEY_UP;
+            event->value.keycode = keys[index];
+            if (masks[index] == WPAD_BUTTON_HOME &&
+                    (current & WPAD_BUTTON_HOME) != 0) {
+                event->type = NSFB_EVENT_CONTROL;
+                event->value.controlcode = NSFB_CONTROL_QUIT;
+            }
+            wii_previous_buttons ^= masks[index];
+            return true;
+        }
+    }
+    return false;
+}
+
+/**
+ * Refresh the cached controller state, at most once every
+ * WII_POLL_INTERVAL_MS.
+ *
+ * WPAD_ScanPads() is what keeps SDL-wii's own pointer and mouse button
+ * handling supplied with fresh data, so it has to happen here whether or not
+ * this file has any use for the result. It is rate limited because
+ * WUPC_UpdateButtonStats() and especially PAD_ScanPads(), which blocks on an
+ * SI transfer, are far too expensive to run once per event loop iteration.
+ *
+ * \return true when there may be an unreported button change to emit.
+ */
+static bool wii_poll_controllers(void)
+{
+    u32 now = SDL_GetTicks();
+
+    if (wii_polled_valid &&
+        (now - wii_last_poll_ticks) < WII_POLL_INTERVAL_MS) {
+        /* Report the cached state so a change spanning several buttons is
+         * still drained one event per call, but do no hardware access. */
+        return wii_polled_buttons != wii_previous_buttons;
+    }
+
+    wii_last_poll_ticks = now;
+
+    if (wii_pointer_joystick != NULL) {
+        SDL_JoystickUpdate();
+    }
+    WPAD_ScanPads();
+
+    wii_polled_buttons = wii_controller_buttons();
+    /* A bare Remote without IR moves the pointer continuously with D-pad. */
+    {
+        WPADData *remote = WPAD_Data(0);
+        wii_pointer_dx = wii_pointer_dy = 0;
+        if (remote != NULL && remote->exp.type == WPAD_EXP_NONE &&
+                !remote->ir.valid) {
+            u32 buttons = WPAD_ButtonsHeld(0);
+            wii_pointer_dx = ((buttons & WPAD_BUTTON_RIGHT) ? 3 : 0) -
+                    ((buttons & WPAD_BUTTON_LEFT) ? 3 : 0);
+            wii_pointer_dy = ((buttons & WPAD_BUTTON_DOWN) ? 3 : 0) -
+                    ((buttons & WPAD_BUTTON_UP) ? 3 : 0);
+            wii_polled_buttons &= ~(WPAD_BUTTON_UP | WPAD_BUTTON_DOWN |
+                    WPAD_BUTTON_LEFT | WPAD_BUTTON_RIGHT);
+        }
+        wii_pointer_pending = wii_pointer_dx != 0 || wii_pointer_dy != 0;
+    }
+    wii_polled_valid = true;
+
+    return wii_polled_buttons != wii_previous_buttons;
+}
